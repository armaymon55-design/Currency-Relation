# Copy to .env and fill in. .env is gitignored and must never be committed.
# None of this is needed for the public ECB build (python -m public.build).

# --- private dashboard: MetaTrader 5 account (read-only use) --------------------
# The terminal supplies the password; only the login number and server go here.
MT5_LOGIN=
MT5_SERVER=
# MT5_TERMINAL=C:\Program Files\XM MT5\terminal64.exe

# --- alerts (optional) ----------------------------------------------------------
# Token from @BotFather. The chat id is filled in automatically after you message the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
